<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="hkgpackagemanager.app"
    android:versionCode="4"
    android:versionName="1.1.0">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="19" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application android:label="HKG Package Manager">
        <activity android:name="hkgpackagemanager.app.MainActivity"
            android:label="HKG Package Manager"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name="hkgpackagemanager.app.QueueService" android:exported="false" />

        <!-- one action per string in core Button.allActions(); keep in step with Button.java -->
        <receiver android:name="hkgpackagemanager.app.ButtonReceiver">
            <intent-filter>
                <action android:name="com.hkmc.intent.action.NAVI_SHORTCUT" />
                <action android:name="com.mobis.intent.action.MEDIAGATE_SHORTCUT" />
            </intent-filter>
        </receiver>

        <receiver android:name="hkgpackagemanager.app.MountReceiver">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

#!/bin/sh
# Returns 0 for the first RESUME_ZEROS calls, then 1. RESUME_ZEROS=forever: always 0.
[ "$1" = sys.boot_completed ] || exit 0
if [ "$RESUME_ZEROS" = forever ]; then echo 0; exit 0; fi
n=0; [ -f "$RESUME_COUNT" ] && read -r n < "$RESUME_COUNT"
if [ "$n" -lt "${RESUME_ZEROS:-0}" ]; then echo 0; else echo 1; fi
echo $((n + 1)) > "$RESUME_COUNT"
